// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // El despliegue es un Worker de Cloudflare (OpenNext). Con el runtime por
  // defecto (`nodejs`) el cliente generado mete el query compiler como WASM en
  // base64 y lo compila en runtime con `new WebAssembly.Module(...)`, que
  // `workerd` prohibe por ser generacion de codigo: todo lo que lee de la base
  // revienta con "Wasm code generation disallowed by embedder"
  // (prisma/prisma#28657). Con `workerd` el `.wasm` se importa como modulo y lo
  // enlaza el empaquetador, sin generacion de codigo en runtime. Detalle en
  // docs/DESPLIEGUE.md, seccion "Prisma 7 necesita `runtime = \"workerd\"`".
  // El precio es que `?module` solo lo entienden los empaquetadores: los scripts
  // de `scripts/` (Node con tsx) cargan el WASM con
  // `scripts/prisma-wasm-node.mjs`, que se pasa con `--import`. No es un valor
  // del generator distinto para Node: seria duplicar el cliente, y con el
  // `src/lib` compartido los dos entran en el bundle del Worker.
  // Tras tocar esto hay que regenerar: `npx prisma generate`.
  runtime  = "workerd"
}

datasource db {
  provider = "postgresql"
}

enum PlayerStatus {
  PENDING
  APPROVED
  REJECTED
  /// Expulsado por una actuación administrativa (`AdminAct` de tipo `BAN`).
  ///
  /// Es un estado **reversible** y conserva todos los datos del participante: no es
  /// la baja destructiva (`deletePlayer`). Un `BANNED` no puntúa (el motor solo
  /// publica `APPROVED`) y no puede recibir una segunda expulsión vigente; para
  /// devolverlo al torneo hay que revertir la actuación. Va al final por la regla de
  /// `ALTER TYPE … ADD VALUE`.
  BANNED
}

enum MatchResult {
  WIN
  LOSS
}

/// Qué hizo una persona administradora del panel.
///
/// Deliberadamente corto: son las acciones que **cambian datos que alguien más ve**
/// (un jugador entra, sale, se le aprueba o se le rechaza la solicitud, o se le
/// corrigen sus datos; una partida deja de puntuar o vuelve a puntuar; entra o sale
/// una persona del panel; se revierte una acción anterior; o cambia la configuración
/// de la edición). Aprobar mete al jugador en la clasificación y rechazar lo deja
/// fuera, así que los dos dejan rastro aunque no lancen una pasada de sincronización.
///
/// Los valores nuevos van **al final del enum**, y no junto a las otras de su grupo,
/// a propósito: en Postgres el orden del enum es su orden de declaración y `ALTER
/// TYPE … ADD VALUE` solo añade al final. Poner uno en medio obligaría a recrear el
/// tipo, que sobre la base de producción es un `db push` que rehace una columna
/// entera por algo que se añade con una sentencia de milisegundos. Ese orden es
/// además el que usa la columna "Acción" del panel al ordenar por tipo
/// (`src/lib/admin.ts`), así que los valores nuevos salen detrás de los viejos, que
/// es lo que espera quien ya tiene filas.
enum AdminActionType {
  PLAYER_CREATED
  PLAYER_REMOVED
  MATCH_POINTS_REVERTED
  MATCH_POINTS_RESTORED
  PLAYER_EDITED
  PLAYER_APPROVED
  PLAYER_REJECTED
  ADMIN_ADDED
  ADMIN_DEACTIVATED
  ADMIN_REACTIVATED
  ACTION_REVERTED
  CONFIG_CHANGED
}

/// Qué hizo una **actuación administrativa** (`AdminAct`).
///
/// Es un historial aparte de `AdminAction`: una actuación tiene una sola acción, una
/// razón pública y, opcionalmente, información privada. Las tres clases no se pueden
/// reducir a dos: una expulsión no cambia partidas, una anulación no cambia el estado
/// del jugador y una reversión no crea ni quita nada, solo deshace otra actuación.
///
/// `REVERSAL` es **final**: una reversión no se puede revertir. Los valores nuevos van
/// al final, como en todos los enums de Postgres.
enum AdminActKind {
  BAN
  MATCH_ANNULMENT
  REVERSAL
}

/// Qué comportamiento anómalo de un participante ha detectado el motor.
///
/// Deliberadamente corto y **fijo en el código**: son las condiciones que el
/// cliente pactó (partidas cortas, rival o compañero repetido, más las tres de
/// estado: la transparencia del historial, las partidas de ladder que no llegan y
/// la pertenencia al servidor de Discord). Lo que sí
/// es configurable son los umbrales, que viven en `Setting["alerts.ruleset"]`:
/// añadir un comportamiento nuevo exige un cambio de esquema, y añadir un umbral
/// no. Cuando haga falta un comportamiento nuevo, se añade el valor al enum y la
/// frase en `src/lib/alerts/rules.ts`; el `switch` de ese módulo es exhaustivo
/// para que un valor sin frase no pueda salir a la base.
///
/// **Dos valores son legado**: `TEAMMATE_ELO_GAP` y `LOW_DIVISION_TEAM_GAME` se
/// retiraron al convertir su caso en una condición de puntuación (una partida por
/// equipos con un compañero a dos escalones o más **no cuenta**; ver
/// `src/lib/ranked-match.ts`). Se quedan porque hay filas ya escritas con ellos y
/// el panel las pinta: lo que no puede borrarse es su etiqueta ni su frase.
///
/// Los últimos no miran las partidas que ya tenemos, sino **el estado del
/// jugador fuera de AoE4World**: que el toggle "Share History" esté en "Public",
/// que la última partida que la ladder le registra nos llegue, que su cuenta de
/// Discord esté en el servidor del torneo y que haya declarado algún canal de
/// directo. Las tres primeras las evalúa el worker del sync
/// (`src/lib/history-checks.ts` y `src/lib/discord/check.ts`), no
/// `computePlayerAlerts()`, porque son datos de `Player` y de fuentes que no son
/// `Match`; la del canal la evalúa `evaluateAlerts()` (`src/lib/alerts/evaluate.ts`),
/// porque es una columna de `Player` que el motor ya lee. Van **al final del enum**
/// por lo mismo que `PLAYER_EDITED`: `ALTER
/// TYPE … ADD VALUE` solo añade al final, y el panel ordena por el enum, así que
/// lo nuevo sale detrás de lo ya escrito.
enum AlertRule {
  SHORT_MATCH_STREAK
  SHORT_MATCH_TOTAL
  REPEATED_OPPONENT_STREAK
  REPEATED_OPPONENT_TOTAL
  REPEATED_TEAMMATE_STREAK
  REPEATED_TEAMMATE_TOTAL
  /// Legado: regla retirada. Su caso es la condición de equipos de la puntuación.
  TEAMMATE_ELO_GAP
  /// Legado: regla retirada. Su caso es la condición de equipos de la puntuación.
  LOW_DIVISION_TEAM_GAME
  HISTORY_NOT_PUBLIC
  MISSING_LADDER_MATCHES
  /// La cuenta de Discord del participante no está en el servidor del torneo, o
  /// no se ha podido comprobar que lo esté.
  ///
  /// Es la tercera regla de **estado** (F12): se comprueba contra la API de
  /// Discord con el bot, no contra `Match`. El vínculo OAuth2 de la inscripción
  /// guarda quién es la persona (`Player.discordUserId`) y lo que después lo
  /// comprueba el worker (`discordInGuild`). Un `null` ahí significa "sin
  /// comprobar" y **no** dispara nada: como en `historyPublic`, un fallo no
  /// puede afirmar lo contrario de lo que se quería comprobar.
  DISCORD_NOT_IN_GUILD
  /// El participante aprobado no tiene **ningún canal de directo** declarado
  /// (`twitchChannel`, `youtubeChannel`, `kickChannel` ni `twitchUrl`).
  ///
  /// Es la única regla **condicional**: solo se evalúa cuando la configuración de
  /// la edición (`Setting["edition.config"].streamingRequired`) declara la
  /// retransmisión obligatoria. Apagarla no borra las alertas ya escritas: `Alert`
  /// es *append-only* y lo que se dejó de comprobar no se desdice.
  NO_STREAM_CHANNEL
  /// No creó **ningún aldeano** en los primeros minutos de una partida concreta.
  ///
  /// Esta y las dos siguientes (`NO_MILITARY_GAP` y `NO_RESOURCES_GAP`) son
  /// **hallazgos sobre una partida**, no sobre una racha de partidas: el dato que
  /// las dispara es el interior de esa partida (`Match.summaryAnomalies`, leído del
  /// summary) y el aviso es uno por partida y regla. Van al final por el mismo
  /// motivo que el resto de valores nuevos.
  NO_VILLAGERS_FIRST_MINUTES
  /// La puntuación militar no subió durante una ventana seguida de la partida,
  /// con una gracia inicial.
  NO_MILITARY_GAP
  /// La suma de recursos recolectados no subió durante una ventana seguida de la
  /// partida.
  NO_RESOURCES_GAP
  /// Hay partidas que llevan más de la ventana de revisión sin una respuesta
  /// concluyente del summary, tras haberlas intentado.
  ///
  /// Es una regla de **estado** del jugador (una fila por jugador), no de una
  /// partida: lo que dice es que no se ha podido revisar su historial reciente. El
  /// caso de perfil privado **confirmado** sigue siendo `HISTORY_NOT_PUBLIC`; este
  /// es el respaldo de lo que no se pudo confirmar.
  SUMMARY_NOT_REVIEWED
}

/// Cuándo se ha detectado la alerta.
///
/// Los cuatro casos no se pueden reducir a menos. Una racha normalmente se avisa
/// **cuando se rompe** (llega una partida sin el patrón), porque es el momento en
/// que se sabe cuánto duró; pero si el torneo se cierra con la racha todavía
/// abierta, el patrón ya no se va a romper nunca y sin este valor esa racha no se
/// avisaría jamás. Los acumulados no son rachas: no tienen ni principio ni fin.
///
/// El cuarto es otro género: `STATE_DETECTED` no marca un tramo ni un acumulado,
/// sino **un estado que se ha comprobado** (el historial público o el cerrado, la
/// ladder por delante de lo que nos llega). No tiene "cuándo cerrar el tramo",
/// tiene "con qué evidencia", y por eso es el único cuyo `anchorGameId` es
/// siempre `null`: la evidencia son las respuestas del sondeo, que van en
/// `details`, y la corrección es que la condición deje de cumplirse.
///
/// `MATCH_DETECTED` (al final, como todos los valores nuevos) es el hallazgo de
/// **una partida concreta**: la evidencia está dentro de esa partida
/// (`Match.summaryAnomalies`) y el ancla es su `gameId`, así que a diferencia de
/// `STATE_DETECTED` **sí lleva partida** y su clave de dedupe la incluye: una fila
/// por partida y regla, no una por jugador.
enum AlertKind {
  STREAK_CLOSED
  STREAK_AT_TOURNAMENT_END
  TOTAL_REACHED
  STATE_DETECTED
  MATCH_DETECTED
}

/// Qué le ha pasado al poseedor de una competición (`ObjectiveLeadEvent`).
///
/// **El orden de declaración es el del feed a igual instante, y no es
/// decorativo**: en Postgres un enum se ordena por el orden en que se declaró, así
/// que con `LOST` delante, un `orderBy` de `kind` con el **mismo `dir`** que el
/// resto de la consulta deja la ganancia delante en descendente (el estado que
/// queda: el nuevo poseedor) y la pérdida delante en ascendente (el inverso
/// exacto). Es el mismo recurso —y la misma advertencia— que en
/// `AdminActionType`: no reordenar los valores, y el que se añada va al final,
/// porque `ALTER TYPE … ADD VALUE` solo añade al final.
///
/// Las dos filas de un cambio de poseedor comparten instante, así que este orden
/// es lo único que las separa en el feed. `OBJECTIVE_LEAD_RANK`
/// (`src/lib/objective-leads.ts`) tiene que decir lo mismo que esta declaración.
enum ObjectiveLeadKind {
  LOST
  GAINED
}

/// Qué le ha pasado al **progreso** de un objetivo (`ObjectiveProgressEvent`).
///
/// Son los tres tipos del contrato de la API del overlay (v1.1.0). **El orden no
/// significa nada**: el feed se ordena por `at`, no por el tipo, así que este enum
/// no se usa como desempate (al revés que `ObjectiveLeadKind`). El que se añada va
/// al final, como en todos los enums de Postgres.
enum ObjectiveProgressKind {
  CUMPLIDO
  PERDIDO
  PROGRESADO
}

model Player {
  id               String       @id @default(cuid())
  profileId        Int          @unique
  // Nombre de **display**: lo escribe quien participa (formulario de
  // inscripción) o el admin. No lo toca el worker nunca, para que el nombre que
  // alguien eligió no dependa de que AoE4World lo cambie por su cuenta.
  name             String
  // Nombre **oficial de AoE4World**, separado del de display para poder publicar
  // los dos. Lo escriben la ladder (que ya lo trae en su entrada) y, si falta o
  // la caché de perfil ha caducado, `GET /players/:profile_id`. `null` = todavía
  // no se ha sincronizado.
  aoe4WorldName    String?
  // Canal registrado en el panel (lo escribe el admin). No es lo mismo que
  // `twitchUrl`, que es lo que AoE4World publica en el perfil del jugador.
  twitchChannel    String?
  // Canal de **YouTube** y de **Kick**, con el mismo sentido y las mismas reglas
  // que `twitchChannel`: lo escribe quien se inscribe o el admin, en minúsculas y
  // ya canónico, y **AoE4World no publica ninguno de los dos**, así que aquí no
  // hay respaldo desde el perfil ni nada que el worker pueda refrescar: son
  // columnas de la persona, no de la API. Por eso no son `String` con el mismo
  // tratamiento que el nombre de canal de Twitch: el handle de YouTube se guarda
  // **sin la arroba** (la forma que consume `forHandle` de la API y la que se
  // usa para componer la URL) y el de Kick es su slug, también sin arroba ni
  // https.
  youtubeChannel   String?
  kickChannel      String?
  // Correo de contacto: lo **exige** el formulario público de `/participar` para
  // que la organización pueda responder dudas, y el panel de administración lo
  // pide **opcional** en el alta y en la edición (mismo criterio que `country`
  // abajo: vacío es `null`, y un valor escrito que no es una dirección es un error
  // en vez de un `null` en silencio).
  //
  // Es nullable a propósito, y no por descuido: las filas que ya existían en la
  // base de producción no lo tienen y no se van a rellenar, y en el panel es
  // opcional. El motor de puntos no lo lee nunca: es un dato de contacto, no de
  // juego, así que no entra en la clasificación ni en ningún desglose.
  contactEmail     String?
  // País del participante, guardado con el **rótulo canónico** de la lista que
  // admite el torneo (`Setting["registration.countries"]`, sembrada desde
  // `paises.txt` con `npm run countries:seed`): "República Dominicana", no "RD" ni
  // "Republica Dominicana". Es un `String` y no un enum porque la lista la cambia
  // la organización sin desplegar, y un enum obligaría a una migración cada vez que
  // entra o sale un país —que es justo lo que este proyecto no puede hacer, porque
  // la base de datos es la de producción y no hay *staging*.
  //
  // Nullable a propósito, y por el mismo motivo que `contactEmail`: el formulario
  // público de `/participar` lo **exige** (es de los datos con los que la
  // organización organiza el torneo), pero en el panel es opcional y las filas que ya
  // estaban guardadas no lo tienen. La columna existe
  // para todas las filas y eso que unas no la informen es información —"no lo
  // sabemos"— y no una fila a medias. Como el correo, el motor de puntos no lo lee:
  // no entra en la clasificación ni en ningún desglose.
  country          String?
  // Identidad de Discord del participante.
  //
  // Lo único de F12 que **no** se escribe a mano en ningún sitio es el
  // `discordUserId`, que solo firma Discord. Del `@usuario` sí se ocupa la
  // organización cuando da de alta a alguien —es un dato que le dan— y esa es la
  // diferencia entre las dos columnas de identidad.
  //
  // Las escriben las dos, y solo las dos: el **vínculo OAuth2** de la inscripción
  // pública (`src/app/api/discord/oauth/callback`) guarda `discordUserId` y
  // `discordUsername` con lo que responde `GET /users/@me`, el **alta de admin**
  // escribe `discordUsername` (que se lo dice la organización) y el **worker** deja
  // `discordUserId`, `discordInGuild` y `discordCheckedAt` con lo que dice la API de
  // Discord. El panel **no edita el `discordUserId`** y `updatePlayer` no lo toca: una
  // cuenta de Discord es una identidad que solo Discord firma, y dejar que alguien la
  // escriba a mano sería no comprobar nada.
  //
  // **Las cuatro son nullable, y por dos motivos distintos.** `discordUserId` es
  // `null` en toda fila anterior a F12 y en todo alta de admin —que escribe el
  // `@usuario` pero no el id, que solo Discord firma— y el worker lo rellena cuando
  // encuentra la cuenta en el roster del servidor. `discordUsername` es `null` solo
  // en las filas anteriores a F12. `discordInGuild` y `discordCheckedAt` son las que
  // escribe el worker, y `discordInGuild === null` significa **"sin comprobar"**,
  // igual que `historyPublic`: no se escribe valor cuando la comprobación falla o no
  // se ha hecho, porque un `false` afirma "no está en el servidor" y eso solo puede
  // salir de una respuesta de Discord.
  //
  // **`discordUserId` es `@unique` a propósito**: una cuenta de Discord no puede
  // quedar vinculada a dos participantes, porque el mismo jugador podría tener dos
  // filas en el torneo y la organización no sabría cuál es cuál al hablar con él
  // por su servidor. Los `null` no colisionan en Postgres (como en el índice único
  // de `Alert.dedupeKey`), así que las filas sin Discord no estorban entre sí. Y como
  // `Player` tiene **tres** unicidades, cada `P2002` se distingue por **qué** columna
  // lo saltó (`profileId`, `discordUserId` y `discordUsername`): son tres problemas
  // distintos y tres mensajes distintos.
  discordUserId    String?      @unique
  // **Nombre de usuario global de Discord** (`pepito`), guardado en su forma
  // canónica: **sin arroba y en minúsculas**, que es exactamente lo que devuelve
  // `GET /users/@me` y lo que trae la lista de miembros del servidor. Es lo que se
  // guarda; lo que **se escribe en los formularios lleva la arroba** (`@pepito`) y
  // es obligatorio empezar por ella, porque en un servidor Discord hay muchos nombres
  // iguales y `@usuario` solo significa una cosa.
  //
  // Es `@unique`, y por el mismo motivo que `discordUserId`: el `@usuario` identifica
  // a una persona en todo Discord, así que dos participantes con el mismo nombre
  // serían la misma cuenta escrita de dos maneras —el alta de admin escribe el
  // `@usuario` que le dice la organización y la inscripción pública lo resuelve por
  // OAuth—, y la organización no sabría a cuál de las dos filas hablarle. Sin la
  // unicidad, el worker no podría ni resolver un `discordUserId` a partir del
  // `@usuario`: dos coincidencias exactas en el roster serían indistinguibles.
  //
  // Los `null` no colisionan en Postgres, así que las filas anteriores a F12 (sin
  // Discord) siguen conviviendo con las nuevas sin estorbar. Y como ahora hay tres
  // unicidades, los tres `P2002` posibles se distinguen por **qué** columna saltó:
  // `profileId`, `discordUserId` y esta.
  //
  // Es **una foto**, igual que lo era sin la unicidad: Discord deja renombrarse, así
  // que el nombre de hoy puede no ser este, y por eso no se usa para decidir nada
  // sobre la pertenencia al servidor. Va para que el panel reconozca a la persona de
  // un vistazo y es lo que el worker usa para **encontrar** la cuenta en el roster.
  //
  // **Al aplicar el `@unique` puede saltar un `P2002`**: dos filas de antes de esta
  // fase pueden tener el mismo nombre con discriminador (`pepito#1234` y
  // `pepito#5678`), que al quitarlo son el mismo `@usuario`. Es el caso que hay que
  // mirar si `db push` se queja (ver `docs/OPERACION.md`).
  discordUsername  String?      @unique
  // ¿Está la cuenta en el servidor del torneo? `null` = sin comprobar (ver arriba).
  // El worker lo refresca con la caché de `DISCORD_CHECK_TTL_HOURS`.
  discordInGuild   Boolean?
  // Cuándo se comprobó lo anterior: es el plazo de la caché y, con
  // `discordUserId === null`, la señal de que esa fila nunca se ha comprobado.
  discordCheckedAt DateTime?

  // --- Verificación del alta por privado de Discord (issue 119) ---
  //
  // El alta de admin ya no deja a nadie dentro sin más: si la verificación está
  // configurada, el bot manda un privado con dos botones y la fila **no puede
  // quedar `APPROVED`** hasta que la persona confirme desde su cuenta. Estas
  // columnas son la máquina de estados de esa puerta, y son nullable porque
  // **las filas anteriores no la tienen**: `requestedAt = null` es "esta fila no
  // está sujeta a verificación", que es justo lo que hace que ni las altas
  // antiguas ni las de `/participar` (que ya prueba la cuenta por OAuth) se
  // bloqueen.
  //
  // `requestedAt` es la **llave de la puerta**: se escribe en toda alta de admin
  // cuando la verificación está configurada y **no se limpia** al rechazar, para
  // que una re-aprobación vuelva a exigir confirmación. Solo la aprobación
  // explícita sin verificación del superadministrador la pone a `null`.
  discordVerificationRequestedAt DateTime?
  // Último privado de verificación enviado. `null` = todavía no se ha mandado (o
  // se ha invalidado al corregir el `@usuario`), y entonces aprobar dispara el
  // envío en vez de esperar confirmación.
  discordVerificationSentAt      DateTime?
  // Token aleatorio que llevan los botones (`pv:c:<token>` / `pv:d:<token>`). Es
  // `@unique` porque es la **única** forma de encontrar la fila desde la
  // interacción: Discord solo devuelve el `custom_id`. Se rota al reenviar, se
  // invalida al corregir el `@usuario` y se limpia al resolverse. **No se expone
  // nunca**: el token permite **encontrar** la fila, pero no basta para resolverla
  // —hace falta pulsar desde la cuenta destinataria (`discordVerificationUserId`) y
  // que la fila siga `PENDING`—, y aun así no sale ni en la capa de datos del panel
  // ni en un log.
  discordVerificationToken       String?         @unique
  // Cuenta de Discord a la que se mandó el privado. La interacción comprueba que
  // quien pulsa es esta persona; sin esa comparación, reenviar el mensaje a otro
  // canal dejaría los botones en manos de cualquiera.
  discordVerificationUserId      String?
  // Cuándo confirmó la persona desde su cuenta. **No confundir con
  // `discordUserId`**: ese es "lo que dice Discord" (OAuth o roster) y puede
  // estar resuelto sin que nadie haya consentido nada; este es la prueba de que
  // la persona pulsó "Sí, participo". Es lo que hace que la puerta deje pasar.
  discordVerifiedAt              DateTime?
  // Cuándo pulsó "No, no participo". Queda como rastro de que la baja fue una
  // decisión de la persona y no de la organización.
  discordDeclinedAt              DateTime?

  status           PlayerStatus @default(PENDING)

  // Cuándo se **inscribió** la persona, no cuándo la aprobó la organización:
  // es el instante del envío del alta (formulario público o alta de admin), y
  // **no se toca al aprobar**. Quien se apunta a tiempo no pierde partidas porque
  // la organización mire su solicitud más tarde.
  //
  // Es lo que hace que el motor no le cuente a un alta posterior el historial
  // anterior: la ventana de puntuaciones no es solo la del torneo, sino
  // `max(window.from, registeredAt)` para cada jugador (ver `scoringCutoff()` en
  // `src/lib/ranked-match.ts`). Los objetivos van con el mismo corte, así que no
  // se puede ganar un objetivo con partidas que no puntúan.
  //
  // **Nullable a propósito, y sin *backfill*.** La base es la de producción y no
  // hay *staging*: `db:push` no debe tocar las filas que ya están, y `null`
  // significa justo lo que les toca a los que ya estaban inscritos —"cuenta desde
  // el inicio de la ventana"—, así que es el valor correcto para ellos, no una
  // falta de información.
  //
  // **No reutiliza `createdAt`.** Una reinscripción de un `REJECTED` reutiliza la
  // fila, así que `createdAt` se queda en el primer
  // envío —que la organización ya miró y rechazó— y no dice cuándo empezó a
  // contar la persona. Solo se escribe en el alta; el diálogo de edición del
  // panel no lo mueve.
  registeredAt DateTime?

  // Lo siguiente se rellena con `GET /leaderboards/rm_solo`, una sola vez por
  // pasada del worker (no una por jugador). Ver `src/lib/aoe4world/ladder.ts`.

  // `rating` de la ladder. Null = el jugador no tiene partidas clasificatorias
  // en la ladder (o todavía no se ha sincronizado): sigue siendo una fila
  // válida del torneo, solo que sin elo ni división.
  elo              Int?
  // `rank_level` literal de AoE4World ("gold_2"), no la división resuelta: la
  // tabla puede querer pintar el tier y la división se deriva en el DAL.
  rankLevel        String?
  // Racha **firmada**: positiva = victorias seguidas, negativa = derrotas
  // seguidas, null = sin ladder. No guardarla en valor absoluto: el signo es
  // la información.
  streak           Int?
  // `games_count` de la misma entrada de ladder (`GET /leaderboards/rm_solo`, el
  // lote de hasta 50 ids por el que salen el elo y la racha): **ninguna llamada
  // nueva**, el campo venía en el payload y hasta aquí se descartaba. `null` = el
  // jugador no ha salido en la respuesta de la ladder, o la API no lo publica.
  ladderGamesCount Int?
  // `last_game_at` de esa misma entrada, y por el mismo motivo.
  //
  // **Va por delante de lo que vemos, y medido cuánto** (2026-10-05, sobre 136
  // jugadores de `rm_solo`): entre 1 y 71 minutos por delante del `startedAt` de la
  // partida más reciente que somos capaces de importar. La ladder se actualiza en
  // tiempo real al empezar la partida y la fila se publica después, así que un
  // `last_game_at` reciente **no** demuestra que falte ninguna partida. El margen
  // con el que hay que comparar está en `LADDER_PUBLICATION_LAG_MINUTES`
  // (`src/lib/history-visibility.ts`), que es donde también vive la comprobación
  // del historial de partidas.
  ladderLastGameAt DateTime?
  // "En directo en Twitch" leído de `twitch_is_live` del mismo endpoint que el
  // elo, así F5 no necesita la API de Helix para el indicador de la clasificación.
  twitchIsLive     Boolean   @default(false)
  // "En directo" en YouTube y en Kick, con el mismo significado que
  // `twitchIsLive`, pero de otra manera: **AoE4World no publica nada de esto**,
  // así que quien lo escribe es el propio worker llamando a cada plataforma
  // (`src/lib/streams/`), y solo para los participantes aprobados que tengan canal.
  //
  // `false` es el estado por defecto y también el degradado: sin `YOUTUBE_API_KEY`
  // la detección de YouTube no se hace, y si el endpoint de Kick deja de
  // responder el valor se queda en `false` con un aviso en el rastro de la pasada.
  // Un `false` aquí significa "no se ha comprobado que esté en directo", que es lo
  // único que se puede decir sin mentir; por eso **no** se escribe cuando el
  // refresco falla, solo cuando la plataforma ha dicho que sí o que no.
  youtubeIsLive    Boolean   @default(false)
  kickIsLive       Boolean   @default(false)
  // Respaldo del canal: si el jugador no tiene `twitchChannel` registrado, la
  // tabla enlaza el que declara en AoE4World.
  twitchUrl        String?
  // `avatars.full`; si es null la interfaz dibuja un monograma.
  avatarUrl        String?
  // Sello de la caché de perfil: cuándo se refrescó por última vez el nombre
  // oficial y el avatar. `null` = sin comprobar. Lo escriben la ladder y
  // `GET /players/:profile_id`; con menos de 1 h no se vuelve a pedir el perfil.
  profileCheckedAt DateTime?
  // Cuándo se miró la ladder por última vez. No se toca si el jugador no
  // aparece en la respuesta, para poder distinguir "sin ladder" de "sin sync".
  ladderUpdatedAt  DateTime?

  // ¿Tiene el participante **abierto** el historial de partidas en el juego? En AoE4
  // hay un toggle "Share History" (menú principal -> retrato -> Match History) y el
  // FAQ de AoE4World dice que los *game summaries* solo existen si está en "Public":
  // con el historial cerrado podemos dejar de verle las partidas sin que nada lo diga.
  //
  // La API **no expone el dato**, así que se comprueba con un `HEAD` a la ruta del
  // sitio que sirve ese summary (`src/lib/history-visibility.ts`), que responde 200
  // si la partida lo tiene y 404 si no. Las otras plataformas no hacen falta: el
  // ajuste es del juego y el summary lo publica AoE4World.
  //
  // **Un `false` afirma "cerrado", y eso solo se puede afirmar con una respuesta.**
  // Un timeout, un 5xx o un error de red no significa cerrado, así que no se
  // escriben: quien no ha podido comprobarlo no toca estas columnas y reintenta más
  // tarde. Por eso `historyPublic` es nullable y `null` significa "sin comprobar".
  historyPublic    Boolean?
  // Cuándo se comprobó por última vez. Da igual de qué valor: es el plazo de la
  // caché, y el `null` de las dos columnas a la vez es lo que hace que un jugador
  // aprobado sin verificar se compruebe en la siguiente pasada.
  //
  // El plazo son 12 h (`HISTORY_CHECK_TTL_HOURS`) porque el worker corre cada ~5 min:
  // sin caché serían tres peticiones por jugador y cada cinco minutos para no
  // aprender nada nuevo. Y no sale gratis: el sitio de AoE4World es el mismo que
  // sirve la API, así que se le habla con el mismo `User-Agent` del cliente y con el
  // mismo ritmo.
  historyCheckedAt DateTime?

  // --- Ventana completa y relleno (F2) ---
  //
  // `windowComplete` significa "se ha recorrido la ventana del torneo entera de
  // este jugador hasta el corte". `false` es el valor de migración y también el
  // de un jugador que entró después: su ventana todavía no se ha recorrido.
  // No es lo mismo que `historyTruncated`, que se ponía a `false` en cuanto
  // llegaba una partida nueva aunque el histórico siguiera cortado.
  windowComplete  Boolean   @default(false)
  // Página del relleno por la que sigue. 1 = empezar por el principio de la
  // ventana; las páginas 1..backfillPage−1 ya se leyeron.
  backfillPage    Int       @default(1)
  // Cuándo se completó por última vez el recorrido de la ventana. `null` = nunca.
  windowCheckedAt DateTime?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  matches         Match[]
  scores          PlayerScore[]
  objectiveEvents ObjectiveEvent[]
  leadEvents      ObjectiveLeadEvent[]
  progressEvents  ObjectiveProgressEvent[]
  progressStates  ObjectiveProgressState[]
  alerts          Alert[]
  // Actuaciones administrativas del jugador. La relación es `SetNull`: una actuación
  // sobrevive al borrado del jugador con la foto de `playerName`/`profileId`.
  adminActs       AdminAct[]

  // Cola del relleno: quién está aprobado, quién tiene la ventana pendiente y
  // por qué página va. El orden de las columnas es el de la consulta de
  // candidatos (`status`, `windowComplete`, `backfillPage`).
  @@index([status, windowComplete, backfillPage])
}

model Match {
  id                String       @id @default(cuid())
  gameId            String
  playerId          String
  player            Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  opponentProfileId Int?
  opponentName      String?
  civ               String?
  opponentCiv       String?
  map               String?
  // Lo que dice la API (o el `kind` si la API no manda `leaderboard`). No se
  // toca: es el registro literal de lo que publicó AoE4World.
  leaderboard       String       @default("rm_solo")
  // Familia de ladder resuelta (`rm_2v2` -> `rm_team`). Es una columna aparte y
  // no un enum porque la lista de qué familias puntúa la da el ruleset, no el
  // esquema: así, añadir un modo a las reglas no obliga a reescribir datos.
  mode              String?
  // La API marca si la civilización de este jugador fue aleatoria. Sin columna
  // el motor tendría que parsear `rawJson` en cada recálculo para poder filtrar.
  civRandomized     Boolean      @default(false)
  // Null mientras la partida sigue en curso: el resultado todavía no existe.
  // El motor solo debe puntuar partidas con `result` y `finishedAt`.
  result            MatchResult?
  startedAt         DateTime
  finishedAt        DateTime?
  durationSeconds   Int?
  // --- Métricas del *summary* de la partida (ver `src/lib/aoe4world/summary.ts`) ---
  //
  // El listado de la API dice quién ganó y con qué, pero no lo que pasó dentro: los
  // APM, cuándo se pasó de edad y cuántos aldeanos se perdieron. Eso solo está en el
  // summary de cada partida (una ruta del **sitio** de AoE4World, no de su API) y lo
  // leen los objetivos `ansioso`, los tres `avance-relampago-*` y
  // `defensor-del-pueblo` (ver `docs/OBJETIVOS.md`).
  //
  // Son columnas **nullable** y `null` significa "**no hay summary**", no "cero": una
  // partida sin summary no puede pasar por una partida sin aldeanos perdidos ni por
  // una racha de APM de cero. `apm` es la marca de que hubo summary y llegó a
  // guardarse; el resto de campos puede faltar legítimamente dentro de un summary (no
  // se llegó al feudal, no se perdió ningún aldeano).
  apm                    Int?
  // Segundos de la partida en que se alcanzó cada edad; gana el **primer** instante
  // (un jugador puede volver a pasar de edad tras perder el edificio).
  feudalAgeSeconds       Int?
  castleAgeSeconds       Int?
  imperialAgeSeconds     Int?
  // Aldeanos perdidos, contados de la lista de bajas del summary. Los dorados y los
  // montados van en su propia columna porque `defensor-del-pueblo` los exige por
  // separado (son aldeanos con otra entrada de `pbgid`: una civilización por cada uno).
  villagersLost          Int?
  gildedVillagersLost    Int?
  mountedVillagersLost   Int?
  // Cuándo se pidió el summary por última vez. `null` = nunca. Se escribe también
  // cuando la respuesta es un 404 ("esta partida no lo tiene"), que es una respuesta
  // concluyente: así no se vuelve a preguntar por ella. Un fallo de red, un 5xx o un
  // 200 ilegible **no** la tocan, así que la partida vuelve a la cola más tarde.
  summaryCheckedAt       DateTime?
  // Cuándo se pidió el summary por última vez, con **cualquier** desenlace (200, 404,
  // fallo, 429). `null` = nunca se intentó. Es distinto de `summaryCheckedAt`: esa
  // marca dice "ya hay una respuesta concluyente" y esta dice "se intentó, saliera lo
  // que saliera". De aquí salen el margen de reintento de una hora y la detección de
  // las partidas que se intentaron y nunca se resolvieron (`SUMMARY_NOT_REVIEWED`).
  summaryLastAttemptAt   DateTime?
  // Evidencia compacta del summary para las alertas de comportamiento: si el
  // `buildOrder` se pudo leer, cuándo se creó el primer aldeano y los dos tramos sin
  // progreso (militar y de recursos). `null` = no hay summary. La forma exacta está en
  // `SummaryAnomalies` (`src/lib/aoe4world/summary-anomalies.ts`); se guarda el resumen
  // y no el payload entero porque lo que el motor necesita son cuatro datos, y
  // `rawJson` no lleva el summary.
  summaryAnomalies       Json?
  // Puntos que esta partida aporta según el ruleset activo: hoy
  // `DEFAULT_RULESET.pointsPerWin` en cada victoria clasificatoria resuelta y 0 en
  // el resto. El motor es el único que lo escribe, y solo en las filas cuyo valor
  // cambia (ver `recomputeScores` en `src/lib/scoring.ts`).
  points            Int          @default(0)
  // Cuándo se dejó de contar esta partida para el torneo. `null` es el estado
  // normal: la partida puntúa.
  //
  // **Por qué es una marca y no un borrado.** El worker de sync vuelve a pedir el
  // histórico del jugador a AoE4World cada pocos minutos, así que una partida
  // borrada reaparece en su siguiente pasada (con sus puntos, si el motor ya no
  // está en medio). Y el panel tiene que poder **deshacer** el cambio: una marca
  // se quita con un `update` y la partida vuelve a puntuar sin que nadie tenga que
  // volver a importarla. Por eso la fila sigue en el histórico, marcada.
  //
  // La regla la lee `src/lib/ranked-match.ts`, en sus tres traducciones a SQL: los
  // puntos por partida, el agregado de la clasificación y los objetivos excluyen
  // todo lo que tenga `revertedAt`, así que una partida revertida no da ni
  // victorias ni objetivos.
  revertedAt        DateTime?
  rawJson           Json
  createdAt         DateTime     @default(now())

  // Vínculos de las actuaciones que anularon esta partida (`AdminAct`).
  adminActMatches   AdminActMatch[]

  // La unicidad es por jugador, no global: en un torneo individual dos
  // participantes pueden jugar la misma partida y cada uno necesita su fila
  // (resultado, civ y puntos propios). Un único `gameId` global descartaría la
  // mitad de los datos de esos cruces.
  @@unique([playerId, gameId])
  @@index([playerId, startedAt])
  // Sostiene la consulta de "partidas en directo" de F4 (`finishedAt IS NULL`).
  @@index([playerId, finishedAt])
  // Sostiene el filtro de partidas clasificatorias: `mode` es igualdad y
  // `startedAt` es rango, que es el orden que aprovecha un índice en Postgres.
  @@index([mode, startedAt])
}

/// Puntuación de un jugador con una versión concreta de las reglas.
///
/// Agregado y no derivado en la consulta: la web lee esta tabla, no `Match`. El
/// `ruleSetVersion` permite publicar reglas nuevas y recalcular al lado de la
/// anterior sin pisarla.
model PlayerScore {
  playerId       String
  ruleSetVersion Int
  player         Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // Puesto de competición (1, 2, 2, 4): dos filas con el mismo total, tasa de
  // victorias, victorias y partidas comparten `rank` y el hueco del puesto
  // compartido se pierde. Se guarda porque el desempate completo no se resuelve en
  // SQL: la tasa se compara con producto cruzado y el orden de presentación
  // dentro de un empate cierra en `Player.profileId`.
  rank    Int
  total   Int @default(0)
  wins    Int @default(0)
  matches Int @default(0)

  // Racha **actual del torneo**, firmada: positiva = victorias clasificatorias
  // seguidas, negativa = derrotas seguidas, `null` = sin ninguna clasificatoria
  // contada (no es `0`: la UI pinta "-"). Sale del barrido de partidas
  // clasificatorias (`aggregatePlayer` en `src/lib/objectives.ts`) y la escribe
  // `recomputeScores()`. No confundir con `Player.streak`, que es la racha de la
  // ladder 1v1 que publica AoE4World: esta es la que pinta la columna "Racha" de
  // la clasificación pública.
  streak Int?

  // Desglose por modo de la regla que produjo esta fila. Es JSON y no columnas
  // porque el número de categorías cambia con cada versión de las reglas.
  breakdown  Json
  computedAt DateTime @default(now())

  // Clave compuesta: una fila por jugador y versión. Indexa también la FK a
  // Player (columna más a la izquierda), que es lo que hace barato el borrado en
  // cascada al eliminar un jugador.
  @@id([playerId, ruleSetVersion])
  // La consulta más caliente del sitio: la clasificación, cuyo orden por `rank`
  // sale del índice (el desempate de un puesto compartido es `Player.profileId`).
  @@index([ruleSetVersion, rank])
}

/// Un **logro** del torneo que alguien cumplió, con **cuándo** se cumplió.
///
/// Un evento por **objetivo y jugador**. Solo aparecen los logros
/// (`kind: "achievement"`): un logro lo cobra todo el que cumple su condición, así
/// que tiene varios beneficiarios. Las **competiciones** no viven aquí, sino en
/// `ObjectiveLeadEvent`, que es el registro de quién posee cada una y cuándo
/// cambió de manos: una competición no se "cumple" una vez, se posee, y su
/// historial es la línea de cambios de poseedor. El historial del panel
/// (`/admin/historial`) lee las dos tablas como un feed; ninguna alimenta la
/// clasificación.
///
/// ## Cuándo se registra (la traducción de `docs/OBJETIVOS.md`)
///
/// El catálogo **no tiene carreras**: los logros se resuelven en caliente y sus
/// beneficiarios pueden cambiar en cada recálculo. Por eso se registran solo
/// cuando la ventana ya tiene `to` informado **y** ha pasado, con
/// `achievedAt` = ese `window.to`. Con la ventana abierta (`to: null`) no se
/// registra nada todavía, que es justo lo que significa "solo se añaden una vez
/// termina el torneo".
///
/// Lo escribe `reconcileObjectiveEvents()` (`src/lib/objective-events.ts`) dentro de
/// la transacción de `recomputeScores()`, así que o hay evento o no hay nada, y los
/// caminos que recalculan (el worker, `npm run score`, revertir o restaurar puntos,
/// aprobar o dar de alta a un jugador) lo dejan al día.
///
/// ## Por qué no guarda `label` ni `points`
///
/// Los dos se resuelven **al leer**, contra el catálogo de `src/lib/objectives.ts` y
/// el ruleset activo: `ruleset.objectives[id] ?? definition.points`, el mismo criterio
/// que aplica `objectiveLookup()` en `src/lib/public.ts`. Copiarlos aquí sería una
/// segunda fuente de verdad que se queda vieja en cuanto la organización retoque un
/// punto o un nombre en `Setting` o en el catálogo, y el historial enseñaría unos
/// puntos que ya no son los del torneo.
///
/// ## Por qué un único evento por objetivo y jugador, y por qué se puede borrar
///
/// La fila es un **espejo reconciliado del cómputo**, no un log *append-only* (la
/// diferencia con `AdminAction`, que sí es un log: allí el rastro vale aunque el
/// cambio se deshaga). La reconciliación borra lo que deja de cumplirse, porque el
/// escenario es real: si se revierte la partida que completó un logro, los puntos se
/// mueven y un evento que nombrara al beneficiario antiguo estaría mintiendo.
/// `@@unique([objectiveId, playerId])` es lo que hace que esa reconciliación quepa en
/// un `update` por esa clave en lugar de un historial de repeticiones.
///
/// Un objetivo **apagado** (`disabledObjectives`) no llega a `awarded`, así que sus
/// filas quedan fuera del espejo y la siguiente reconciliación las borra.
///
/// ## El borrado en cascada
///
/// El de `Match` y `PlayerScore`: si se borra un participante, sus hitos no pueden
/// quedarse sin dueño. El `playerId` abre un índice compuesto porque Postgres no indexa
/// las FK por su cuenta y el `Cascade` las recorre (y porque el panel filtra los hitos
/// por jugador).
model ObjectiveEvent {
  /// Id estable del catálogo (`loco-por-ganar`, `lider-japanese`…).
  objectiveId String
  /// Quien lo cobró.
  playerId    String
  player      Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  /// Fin del torneo (la ventana ya cerrada) cuando se registra el objetivo.
  achievedAt DateTime
  /// Cuándo se escribió la fila. `achievedAt` es el dato del torneo; esto es solo
  /// el rastro de que alguien lo registró (el motor corre cada 10 minutos).
  recordedAt DateTime @default(now())

  // Un evento por objetivo y jugador: un logro tiene varios beneficiarios.
  @@unique([objectiveId, playerId])
  // El feed del historial filtra y ordena por `achievedAt` y desempata por `objectiveId`.
  // Sustituye al índice simple de `achievedAt`, que era su prefijo.
  @@index([achievedAt, objectiveId])
  // Filtro por jugador y cascada; el `achievedAt` de detrás sostiene el feed de un jugador.
  // Sustituye al índice simple de `playerId`, que era su prefijo.
  @@index([playerId, achievedAt])
}

/// Un cambio de poseedor de una **competición**: quién pasa a poseerla o deja de
/// poseerla, y **cuándo**.
///
/// Es un registro **append-only**, al revés que `ObjectiveEvent`. Aquí la fila
/// describe un hecho que ocurrió en un instante —el jugador pasó a liderar «Rey del
/// 1v1»— y eso no deja de ser cierto porque después cambie el poseedor: lo que hay
/// que anotar es el cambio siguiente, no corregir el anterior. Es justo lo que el
/// espejo no puede hacer: una competición se posee durante semanas y se puede
/// perder y recuperar, así que su historial es una línea temporal de ganancias y
/// pérdidas, no un "cumplido" con fecha.
///
/// ## Qué escribe, y qué dos filas escribe un cambio
///
/// `reconcileObjectiveLeadEvents()` (`src/lib/objective-leads.ts`), dentro de la
/// transacción de `recomputeScores()`, deriva de `awarded` el poseedor actual de
/// cada competición, lo compara con el **último estado anotado** y anexa solo lo que
/// difiere:
///
/// - **cambio de poseedor**: dos filas con **el mismo `at`**, `LOST` para el
///   anterior y `GAINED` para el nuevo;
/// - **poseedor que desaparece** (objetivo apagado, ventana reabierta, una partida
///   revertida que cambia el ranking): una sola `LOST`;
/// - **competición sin filas previas y con poseedor**: una sola `GAINED` (siembra).
///
/// **La siembra no reconstruye el pasado**: el primer estado de una competición se
/// anota con el instante del pase que lo descubre, no con la fecha en que el jugador
/// se puso a liderar, que no consta en ninguna parte.
///
/// Es idempotente y **no escribe nada cuando no cambia nada** (el worker pasa 288
/// veces al día): la comparación es una lectura del registro de la edición en curso
/// y la escritura solo sale si hay diferencia. La única clave única posible sería
/// `(objectiveId, playerId, kind, at)`, y no se pone: no impediría el caso real que
/// hay que evitar (una repetición con otro instante), así que la idempotencia la
/// sostiene la comparación, no una restricción.
///
/// ## Cohortes: la edición sella cada fila
///
/// `editionFrom` es el `window.from` de la ventana **con la que se escribió** la
/// fila. Los dos feeds publican solo las filas de la edición activa —igualdad con el
/// `from` de la ventana que se está usando—, así que una edición nueva arranca su
/// propio registro sin mezclar los liderazgos de la anterior. Y como el filtro es
/// por ventana y no por la fecha de la fila, **sí se ven** las correcciones
/// posteriores al cierre de la edición en curso: una partida revertida después del
/// cierre cambia el poseedor y anexa sus dos filas, que siguen siendo de esta
/// edición.
///
/// ## Por qué no guarda la etiqueta ni los puntos
///
/// Por el mismo motivo que `ObjectiveEvent`: se resuelven **al leer**, con
/// `resolveObjective()` y el ruleset activo, y una copia se quedaría vieja en cuanto
/// la organización retocara un punto. En una competición el importe es el mismo para
/// la pérdida y para la ganancia (premio fijo, una sola vez), así que las dos filas
/// de un cambio llevan la misma cifra y la interfaz decide el signo.
///
/// ## El borrado en cascada
///
/// Igual que en `ObjectiveEvent`: si se borra un participante, sus liderazgos no
/// pueden quedarse sin dueño. `playerId` abre un índice compuesto porque Postgres no
/// indexa las FK por su cuenta y el `Cascade` las recorre (y porque el panel filtra por
/// jugador).
model ObjectiveLeadEvent {
  id String @id @default(cuid())

  /// Id del catálogo de la competición (`loco-por-ganar`, `rey-1v1`, `masterizando-…`).
  objectiveId String

  /// Quien pasa a poseerla (`GAINED`) o quien deja de poseerla (`LOST`).
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  /// Qué le ha pasado a ese jugador con esa competición.
  kind ObjectiveLeadKind

  /// Instante del cambio: el del recálculo que lo detectó, **el mismo en las dos
  /// filas** de un cambio de poseedor. En la siembra es el instante del pase.
  at DateTime

  /// `window.from` de la ventana activa cuando se escribió; ver el docblock.
  editionFrom DateTime

  /// Cuándo se escribió la fila. `at` es el dato del torneo; esto es solo el rastro
  /// de que el motor lo registró (corre cada 10 minutos).
  recordedAt DateTime @default(now())

  // Feed: la cohorte y el rango de `at` de la consulta, con el orden del merge
  // (`at`, `objectiveId`, `kind`) detrás. Sustituye al índice `(editionFrom, at)`, que
  // era su prefijo.
  @@index([editionFrom, at, objectiveId, kind])
  // Filtro por jugador y cascada; la cohorte y la fecha de detrás sostienen su historial.
  // Sustituye al índice simple de `playerId`, que era su prefijo.
  @@index([playerId, editionFrom, at])
}

/// Un cambio de **progreso** de un objetivo: cuándo un jugador lo cumplió, lo perdió
/// o avanzó hacia él, **con los valores** de progreso de ese instante.
///
/// Es el feed que lee la API del overlay (v1.1.0): `GET /api/v0/clasificacion`
/// publica, por objetivo, los eventos de esta tabla con su `tipo`, su `fechahora` y su
/// `progreso { propio, ajeno? }`. Sin estos valores no se puede pintar la barra del
/// overlay, y **ninguna de las tablas de historial que ya existen los guarda**:
/// `ObjectiveEvent` solo anota el cierre de la ventana (un logro, sin cifras) y
/// `ObjectiveLeadEvent` solo el cambio de poseedor de una competición.
///
/// ## Append-only, y no un espejo
///
/// Al revés que `ObjectiveEvent`, aquí la fila describe un hecho que ocurrió en un
/// instante —"a las 21:04 pasó de 7 a 8 victorias"— y eso no deja de ser cierto
/// porque después se revierta una partida: lo que hay que anotar es el cambio
/// siguiente. Un espejo no serviría: el overlay necesita la secuencia, no el estado
/// final.
///
/// `ObjectiveProgressState` es lo otro: el estado **interno** con el que la
/// reconciliación compara para saber qué cambió. Esta tabla es el registro
/// publicado; aquella, la memoria de trabajo. No son el mismo dato y no se pueden
/// reducir a uno.
///
/// ## Sin FK al catálogo
///
/// `objectiveId` es el id estable del catálogo (`victorias`, `imparable`,
/// `loco-por-ganar`…), una constante de código (`src/lib/objectives.ts`), igual que en
/// `ObjectiveEvent` y `ObjectiveLeadEvent`: no hay tabla de objetivos que referenciar
/// y un enum obligaría a una migración por cada objetivo nuevo.
///
/// ## La cohorte de edición
///
/// `editionFrom` es el `window.from` de la edición que sella la fila, como en
/// `ObjectiveLeadEvent`. Aísla las ediciones: la API filtra por la edición activa, así
/// que una edición nueva arranca su propio feed sin mezclar el progreso de la
/// anterior.
///
/// ## Por qué guarda los valores
///
/// `ownValue` es el progreso propio en el instante del evento; `otherValue` es el del
/// **nuevo poseedor** en un `PERDIDO` (`null` si no hay nadie) y `repetition` es la
/// repetición en los objetivos que la tienen (`victorias`, `imparable`; `null` en el
/// resto). El contrato del overlay pide el progreso histórico **exacto**, y el valor
/// de hoy no sirve para reconstruir el de ayer.
///
/// ## Qué instante es `at`
///
/// El del **recálculo que detectó el cambio**, no la fecha de la partida. La siembra
/// **no reconstruye el pasado**: el primer estado de un objetivo se anota con el
/// instante del pase que lo descubre, porque el momento en que empezó a progresar no
/// consta en ninguna parte. En la siembra de un logro con la ventana ya cerrada sí es
/// `window.to`, que es cuando el torneo lo da por cumplido.
///
/// ## Quién la escribe
///
/// `recomputeScores()`, en la misma transacción que la clasificación.
///
/// ## El borrado en cascada
///
/// Igual que en las otras dos tablas de historial: si se borra un participante, sus
/// eventos no pueden quedarse sin dueño. `playerId` abre un índice compuesto porque
/// Postgres no indexa las FK por su cuenta y el `Cascade` las recorre (y porque la API
/// filtra por jugador).
model ObjectiveProgressEvent {
  id String @id @default(cuid())

  /// Id del catálogo de objetivos (`victorias`, `imparable`, `loco-por-ganar`…).
  objectiveId String

  /// El jugador al que le cambió el progreso.
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  /// Qué le ha pasado: lo cumplió, lo perdió o avanzó hacia él.
  kind ObjectiveProgressKind

  /// Instante del recálculo que detectó el cambio; en la siembra de un logro con la
  /// ventana cerrada, `window.to`. Ver el docblock.
  at DateTime

  /// `window.from` de la edición que sella la cohorte; la API filtra por la activa.
  editionFrom DateTime

  /// Progreso propio en el momento del evento.
  ownValue Int

  /// Valor del **nuevo poseedor** en un `PERDIDO`; `null` si no hay poseedor. En los
  /// otros dos tipos no hay "ajeno" que anotar y también es `null`.
  otherValue Int?

  /// Repetición en los objetivos repetibles (`victorias`, `imparable`); `null` en el
  /// resto.
  repetition Int?

  /// Cuándo se escribió la fila. `at` es el dato del torneo; esto es solo el rastro
  /// de que el motor lo registró (corre cada 10 minutos).
  recordedAt DateTime @default(now())

  // La consulta de la API: jugador, edición y `at >= desde`, en el orden del feed.
  @@index([playerId, editionFrom, at])
  // Cohorte y orden del feed, para publicar una edición entera.
  @@index([editionFrom, at, objectiveId])
}

/// El **estado actual** del progreso de un jugador en un objetivo, dentro de una
/// edición: la memoria de trabajo de la reconciliación.
///
/// Existe para que el recálculo sepa **qué cambió** sin releer el feed entero: carga
/// el estado de la edición, lo compara con el cómputo de este pase y, por cada
/// diferencia, anexa el evento correspondiente en `ObjectiveProgressEvent`. El feed
/// publicado y este estado son dos cosas distintas a propósito: uno es historia y no
/// se toca; el otro se reescribe en cada pase.
///
/// Una fila por jugador, objetivo y edición (la clave primaria), porque el progreso
/// **se reinicia con la edición**: la misma persona vuelve a empezar de cero en la
/// siguiente. `value` es el progreso **recortado al máximo** en los objetivos con
/// tope (un logro con tope no sigue subiendo aunque se cumpla más veces);
/// `completed` dice si posee la competición o ha completado el logro, que no es lo
/// mismo que "tiene el máximo"; `repetition` es la repetición actual en los
/// repetibles.
///
/// Lo escribe `recomputeScores()` en la misma transacción que la clasificación. El
/// `Cascade` borra el estado al borrar el jugador, igual que los eventos: un estado
/// sin dueño no le sirve a nadie.
model ObjectiveProgressState {
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  /// Id del catálogo de objetivos, como en `ObjectiveProgressEvent`.
  objectiveId String

  /// `window.from` de la edición a la que pertenece este estado.
  editionFrom DateTime

  /// Progreso actual, recortado al máximo en los objetivos con tope.
  value Int

  /// Posee la competición o ha completado el logro.
  completed Boolean

  /// Repeticiones actuales en los objetivos repetibles; `null` en el resto.
  repetition Int?

  updatedAt DateTime @updatedAt

  // Una fila por jugador, objetivo y edición. `playerId` a la izquierda indexa
  // también la FK, que es la que recorre el `Cascade`.
  @@id([playerId, objectiveId, editionFrom])
  // Carga del estado de una edición entera en la reconciliación.
  @@index([editionFrom, objectiveId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Contador de frecuencia de los endpoints públicos sin sesión.
///
/// Una fila por clave, y la clave **nunca** es una IP: es su HMAC-SHA-256
/// (`ip:<hex>`) o el cubo compartido `global` cuando la petición no trae una IP
/// identificable. Solo se guarda el hash, y el hash es lo que se cuenta, así que
/// la tabla no contiene datos personales y ni un log puede reconstruirlos.
///
/// La ventana es fija, no deslizante: `windowStart` es el inicio de la ventana en
/// curso y el contador vuelve a 1 cuando esa ventana caduca. El incremento
/// happens en **una sola sentencia** (`INSERT ... ON CONFLICT DO UPDATE` en
/// `src/lib/rate-limit.ts`) porque el despliegue es serverless: la memoria de
/// proceso no valdría, y dos envíos simultáneos tienen que serializarse en la
/// base de datos en vez de colarse cada uno por su lado.
///
/// No lleva índice en `windowStart` a propósito: la limpieza de filas caducadas
/// (`deleteMany`) es periódica y el contenido es una fila por clave vista, así
/// que un recorrido secuencial de una tabla tan pequeña sale más barato que
/// mantener un índice que solo se usaría en ese borrado.
model RateLimitCounter {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Una cuenta con acceso al panel de administración.
///
/// Es la lista explícita de quién puede entrar. Hasta ahora, **cualquier**
/// usuario de Supabase Auth lo era —los registros públicos están desactivados, así
/// que solo hay cuentas creadas por la organización— y eso hacía imposible dar de
/// baja a nadie. Con esta tabla, la comprobación de acceso (`requireAdmin()`) deja
/// pasar al correo del superadministrador (`SUPERADMIN_EMAIL`) o a una fila
/// **activa** de aquí.
///
/// **La baja es `active = false`, no un borrado.** La organización quiere poder
/// desactivar a alguien sin perder la relación con lo que hizo —su `authUserId` y
/// la fecha en la que entró—, y una baja que borrara la fila obligaría a inventar un
/// histórico aparte. El rastro de **quién** hizo qué no vive aquí: está en
/// `AdminAction`, que es append-only y no depende de esta tabla.
///
/// **No hay columna de rol.** El superadministrador es **único** y sale del entorno
/// (`SUPERADMIN_EMAIL`), no de la base: así esta tabla es solo "quién es admin
/// normal" y el único poder que no se puede delegar por descuido —administrar a los
/// propios admins— no se puede conceder por error desde el panel.
///
/// `email` es la clave de identidad y va **canónico** (en minúsculas y sin
/// espacios): es lo que se compara en cada petición, y dos formas del mismo correo no
/// pueden ser dos filas. `authUserId` es el vínculo con Supabase Auth —con el que se
/// le banea al darle de baja y se le desbanea al reactivarlo— y es **opcional** a
/// propósito: la fila se puede escribir antes de que el usuario exista en Auth, y las
/// cuentas de los admins anteriores se vinculan al darse de alta por invitación. Es
/// `@unique` porque una cuenta de Auth no puede ser dos admins, y los `null` no
/// colisionan en Postgres (como en `Player.discordUserId`), así que las filas sin
/// vincular no estorban entre sí.
model Admin {
  id            String    @id @default(cuid())
  /// Correo canónico (minúsculas, sin espacios). Es lo que se compara al entrar.
  email         String    @unique
  /// `auth.users.id` de Supabase Auth. `null` = aún sin vincular.
  authUserId    String?   @unique
  /// `false` = dado de baja: pierde el acceso sin borrar la fila.
  active        Boolean   @default(true)
  /// Cuándo se dio de baja. `null` mientras está activa.
  deactivatedAt DateTime?
  /// Correo de quien le dio de alta. También queda en `AdminAction`; aquí se lee
  /// sin recorrer el historial.
  addedByEmail  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// Una acción del panel de administración, para poder pintar su historial.
///
/// Es un registro **append-only**: nadie edita filas y lo único que se borra es la
/// que una compensación acaba de escribir, para que el rastro no describa un cambio
/// que se ha deshecho. La única excepción es la marca de revertida
/// (`revertedAt`/`revertedByEmail`), que **se escribe encima** de la fila original en
/// vez de borrarla: el rastro de lo que se hizo tiene que sobrevivir a que se
/// deshaga, y la marca es lo que dice que ya no está vigente. No guarda una foto del
/// estado de la web, sino quién hizo qué y sobre qué fila, que es lo que hace falta
/// cuando alguien pregunta por qué el torneo puntúa como puntúa.
///
/// `summary` está **ya redactado en español** en el momento de escribir la fila
/// (`src/lib/admin-actions.ts`): la pestaña de acciones lo pinta tal cual y no monta
/// la frase en el cliente, donde un nombre con comillas o un número en cualquiera
/// de los dos sitios acabarían dando textos distintos. Los datos estructurados que
/// hay detrás van en `details`, y de ahí no se lee nada para pintar el historial: es
/// para el que tenga que investigar.
model AdminAction {
  id   String          @id @default(cuid())
  type AdminActionType

  // Quién lo hizo. Es el correo del usuario de Supabase Auth que pasó
  // `requireAdmin()`: el dato ya está en la sesión, así que el historial no depende de
  // leer la tabla `Admin`, que es solo la lista de quién puede entrar.
  actorEmail String

  // Una línea en español, ya formateada. Ver `adminActionSummary()`.
  summary String

  // `Player.id`, `Match.id` o `Admin.id` de la fila afectada, según el `type`. Es
  // texto y no una FK a propósito: la misma columna vale para varias tablas y no
  // obliga a decidir la regla de borrado de una acción cuando se borre su fila.
  targetId String?

  // Datos estructurados de la acción (`profileId`, `gameId`, puntos antes y
  // después…). Nullable porque no todos los tipos tienen los mismos.
  details Json?

  // Marca de "esta acción se ha revertido", reversible, para las acciones que el
  // panel permite deshacer. `null` = la acción sigue vigente. Se usa una marca y
  // no un borrado por el mismo motivo que `Match.revertedAt`: el rastro vale aunque
  // el cambio se deshaga, y borrar la fila dejaría el historial contando algo que ya
  // no es verdad. Quién la revirtió va aparte para no depender del `actorEmail` de la
  // fila —que es quien hizo la acción, no quien la deshizo—.
  revertedAt      DateTime?
  revertedByEmail String?

  createdAt DateTime @default(now())

  // El primero sostiene la paginación del historial, que siempre es "lo más
  // reciente primero". El segundo sirve para filtrar por tipo sin perder el
  // orden: con `type` a la izquierda y `createdAt` a la derecha, el índice ya
  // está en el orden que necesita la consulta.
  @@index([createdAt])
  @@index([type, createdAt])
}

/// Un comportamiento anómalo de un participante, detectado sobre las partidas
/// clasificatorias que ya están guardadas.
///
/// Es un registro **append-only**, igual que `AdminAction`, y por el mismo
/// motivo: nadie edita filas y nada reescribe una alerta ya escrita. La
/// corrección no es borrar la alerta que salió mal, es que la condición que la
/// produjo deje de cumplirse (una partida revertida, una ventana movida, un
/// umbral retocado) y el informe dé cuenta del estado en cada momento.
///
/// ## Por qué `dedupeKey` y no un índice único compuesto
///
/// El motor es **idempotente** y se ejecuta muchas veces sobre los mismos datos
/// (cada pasada del sincronizador, el cierre de torneo, `npm run alerts:check`),
/// así que tiene que poder insertar "solo lo nuevo" sin leer antes lo que ya hay:
/// eso es un `createMany({ skipDuplicates: true })` sobre un único índice único.
/// La clave se compone en código porque en Postgres los `NULL` de un índice
/// único **no colisionan** (dos filas con `subjectProfileId = NULL` pasarían
/// ambas), y el sujeto es opcional: las reglas sin sujeto (partidas cortas) lo
/// tienen a `null`. Un índice único compuesto
/// con columnas nullable no sujetaría lo que parece sujetar, así que la clave es
/// una columna de texto no nula que se construye siempre con los mismos
/// ingredientes y cuyo contenido es determinista.
///
/// Lo que identifica una alerta es (regla, tipo, jugador, sujeto, y el remate:
/// la partida que rompió la racha o el número que se ha cruzado). Por eso el
/// `kind` entra en la clave: una racha que se rompe y una que solo la cerró el
/// fin del torneo son alertas distintas del mismo tramo, y sin él colisionarían.
///
/// **La regla de estado (`STATE_DETECTED`) es la excepción, y a propósito.** Un
/// estado no tiene remate: o se cumple o no se cumple, y su corrección es que
/// deje de cumplirse (el jugador abre el historial; la ladder vuelve a coincide
/// con lo que nos llega). Si su clave llevara la partida ancla o el número
/// medido, y estos se reevalúan **cada 10 minutos**, insertaría una fila nueva
/// cada 12 horas para siempre. Por eso su clave es solo (regla, tipo, jugador):
/// una alerta por jugador y por hecho, y la fila dice "esto se detectó", no
/// "esto se detectó por nth vez".
///
/// `summary` está **ya redactado en español** en el momento de escribir la fila
/// (`src/lib/alerts/rules.ts`), igual que en `AdminAction`: el informe lo pinta
/// tal cual y no monta la frase en el cliente, donde un número o un nombre con
/// comillas acabarían dando dos textos distintos. `details` es lo que hay detrás,
/// para el que tenga que investigar, y de ahí no se lee nada para el resumen.
model Alert {
  id   String    @id @default(cuid())
  rule AlertRule
  kind AlertKind

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // A quién se refiere la alerta, cuando tiene alguien: el `profileId` del rival
  // (R2) o del compañero (R3). Son jugadores de la liga o no, y por eso es un
  // `profileId` de AoE4World y no una FK a `Player`. `null` en las reglas sin
  // sujeto.
  subjectProfileId Int?
  // Nombre del sujeto **en el momento de escribir la alerta**: es el único
  // registro que queda de a quién señalaba, y un rival o un compañero externo a
  // la liga no va a aparecer en ningún `join` del panel.
  subjectName      String?

  // Magnitud del hallazgo: partidas de la racha para los avisos de racha,
  // partidas acumuladas para los de total y **segundos del tramo** para los
  // hallazgos de una partida (`MATCH_DETECTED`). En `NO_VILLAGERS_FIRST_MINUTES`
  // es 0, "cero aldeanos", y el umbral es la ventana del arranque. En un total es
  // siempre el múltiplo o el umbral que se ha cruzado, así que `count == threshold`.
  //
  // Las reglas de estado (`AlertKind.STATE_DETECTED`) no cuentan nada: ahí
  // `count` es la magnitud **con la que se comparó** y `threshold` el valor con
  // el que se comparó, para que el informe diga por qué se avisó sin deducirlo
  // de la regla. En `HISTORY_NOT_PUBLIC` son las partidas sondeadas sin summary
  // y las que se exigen; en `MISSING_LADDER_MATCHES`, los minutos que la ladder
  // va por delante y el margen de publicación. Lo demás (los `gameId` sondeados,
  // las dos fechas comparadas) va en `details`.
  count     Int
  // Umbral que dispara el aviso, tomado del ruleset activo. Se guarda para que
  // el informe pueda decir con qué criterio se avisó aunque las reglas cambien
  // después. En las tres reglas de partida del resumen es el umbral del ruleset
  // (segundos de la ventana, o la ventana del arranque en la de aldeanos).
  threshold Int

  // Partida que **rompió** la racha (la primera clasificatoria sin el patrón) o
  // cruzó el umbral; en el cierre de torneo, la última de la racha, que es la
  // única que se puede señalar porque no hay ninguna que la rompiera.
  // `null` en las reglas de estado —no hay partida que rompa nada— y también si
  // algún día una regla dispara sin partida que señalar.
  anchorGameId String?

  dedupeKey String @unique
  summary   String
  details   Json

  createdAt DateTime @default(now())

  // El primero sostiene "lo más reciente primero" del panel, que es la consulta
  // de lectura. El segundo sirve para el detalle de un jugador sin perder ese
  // orden, y para contar cuántas alertas de cada regla ha tenido.
  @@index([createdAt])
  @@index([playerId, rule])
}

/// Una **actuación administrativa**: la unidad con la que la organización expulsa a
/// un participante, anula partidas ganadas o revierte actuaciones anteriores.
///
/// Es un historial **aparte de `AdminAction`**, no una fila más de aquella tabla: la
/// actuación tiene razón pública (la que se anuncia en Discord), información privada
/// (que nunca sale del panel), autor y fecha, y además se aplica en el momento. Los
/// `AdminAction` siguen siendo el rastro técnico de cada cambio; la actuación es el
/// expediente que lo explica.
///
/// ## Una acción por actuación
///
/// `kind` decide qué se hizo y solo se puede hacer una cosa: una expulsión y una
/// anulación del mismo jugador son **dos actuaciones**. El único caso que selecciona
/// varias filas es la reversión, que puede deshacer varias actuaciones vigentes del
/// mismo participante a la vez.
///
/// ## La razón pública y la privada
///
/// `publicReason` es obligatoria y es lo único que se manda a Discord (canal y DM).
/// `privateInfo` es opcional y **no sale del panel ni se loguea**: el aviso público no
/// la recibe por tipo (ver `src/lib/admin-acts.ts`), así que no se puede filtrar por
/// descuido. `summary` es una frase ya redactada en español, como
/// `AdminAction.summary`, y no contiene información privada.
///
/// ## El borrado del jugador
///
/// `playerId` es nullable y `SetNull`: una actuación sobrevive a que se borre el
/// jugador, con la foto de `playerName`/`profileId` del momento. Eso conserva el
/// historial de una expulsión que luego se revierte y el jugador se da de baja.
model AdminAct {
  id String @id @default(cuid())

  kind AdminActKind

  /// `Player.id`, o `null` si el jugador se ha borrado después.
  playerId String?
  player   Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  /// Foto del nombre y del perfil en el momento de la actuación: es lo que queda si
  /// la relación con `Player` se pone a `null`.
  playerName String
  profileId  Int

  /// Frase ya redactada en español (`adminActSummary()`); el panel la pinta tal cual.
  summary String

  /// Razón pública obligatoria: es lo único que se manda en el canal y en el DM.
  publicReason String
  /// Información privada opcional: nunca sale del panel ni se loguea.
  privateInfo  String?

  /// Correo del usuario de Supabase Auth que la creó.
  actorEmail String

  /// Partidas anuladas, o en una reversión el total de partidas afectadas por las
  /// actuaciones revertidas (unión, sin repetir).
  matchCount Int @default(0)

  /// Estado que tenía el jugador antes de una expulsión. `null` en los otros tipos.
  /// Es lo que restaura la reversión.
  statusBefore PlayerStatus?

  /// Cuándo la revirtió otra actuación. `null` = sigue vigente. En una `REVERSAL`
  /// siempre es `null`: una reversión es final y no se revierte.
  revertedAt      DateTime?
  revertedByEmail String?

  /// La actuación de reversión que la deshizo, si existe. Autorrelación con
  /// `SetNull`: la reversión es una fila más de este mismo historial.
  reversedByActId String?
  reversedByAct   AdminAct?  @relation("AdminActReversal", fields: [reversedByActId], references: [id], onDelete: SetNull)
  reverses        AdminAct[] @relation("AdminActReversal")

  /// Partidas anuladas por esta actuación (vacío en una expulsión o una reversión).
  matches AdminActMatch[]

  createdAt DateTime @default(now())

  // Listado por fecha (lo más reciente primero), filtro por tipo y por jugador, y
  // estado vigente/revertido. El último sostiene la autorrelación.
  @@index([createdAt])
  @@index([kind, createdAt])
  @@index([playerId, createdAt])
  @@index([revertedAt, kind])
  @@index([reversedByActId])
}

/// Qué partidas anuló una actuación (`AdminAct` de tipo `MATCH_ANNULMENT`).
///
/// Es la lista de vínculos, no una copia de la partida: los datos se leen en vivo de
/// `Match`. El `Cascade` en los dos lados es deliberado: si se borra la actuación o la
/// partida, el vínculo no puede quedarse apuntando a nada.
model AdminActMatch {
  actId String
  act   AdminAct @relation(fields: [actId], references: [id], onDelete: Cascade)

  matchId String
  match   Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@id([actId, matchId])
  // La consulta "qué actuaciones anularon esta partida" y el `Cascade` desde `Match`.
  @@index([matchId])
}
