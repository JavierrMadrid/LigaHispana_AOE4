# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# opennext (salida del build del Worker)
/.open-next/

# cache local de wrangler (wrangler dev / npm run preview)
/.wrangler/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# secretos de wrangler: lleva la contraseña de la base de datos en la cadena local
# que Hyperdrive necesita para emular el binding en `wrangler deploy`. No casa con
# `.env*` de arriba, asi que sin esta linea se subiria al repositorio.
.dev.vars
.dev.vars.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma-generated agent skills
/.claude/
/.windsurf/
/.agents/
/skills-lock.json

/src/generated/prisma
