# PostgreSQL connection string for Prisma.
# Local via `npx prisma dev`, or a cloud DB (Neon / Prisma Postgres / Supabase).
DATABASE_URL="postgresql://user:password@localhost:5432/ligahispana_aoe4?schema=public"

# --- AoE4World (worker de sincronización, fase F2) ---------------------------
# Base de la API. Cambiarlo permite apuntar a un mock en las verificaciones.
AOE4WORLD_API_BASE="https://aoe4world.com"
# Timeout por petición, en ms.
AOE4WORLD_TIMEOUT_MS="15000"
# Identificarse en la API es buena práctica y ayuda a diagnosticar bloqueos.
AOE4WORLD_USER_AGENT="LigaHispanaAOE4/0.1 (sync AoE4World)"
# Opcional: solo para partidas privadas. Viaja en la query (como exige la API) y
# nunca se escribe en los logs.
AOE4WORLD_API_KEY=""
# Ritmo y reintentos (valores por defecto razonables, se pueden ajustar).
AOE4WORLD_MAX_RETRIES="3"
AOE4WORLD_RETRY_BASE_MS="500"
AOE4WORLD_RETRY_MAX_MS="15000"
AOE4WORLD_MIN_REQUEST_INTERVAL_MS="300"
# Tamaño y tope del histórico por jugador en cada pasada.
# La API nunca devuelve más de 50 partidas por página, por mucho que se pida.
AOE4WORLD_SYNC_PAGE_SIZE="50"
AOE4WORLD_SYNC_MAX_PAGES="10"
AOE4WORLD_SYNC_CONCURRENCY="3"
# Plazo global de una pasada: si se agota, el lote termina y se registra.
AOE4WORLD_SYNC_DEADLINE_MS="240000"
# Mock local de la API (fixtures en src/lib/aoe4world/mock/): sirve un torneo
# simulado de 10 participantes sin salir a la red. Solo desarrollo: si está
# activo con NODE_ENV=production, la configuración falla al arrancar.
# `npm run mock:tournament` lo activa por sí mismo, no hace falta ponerlo aquí.
AOE4WORLD_MOCK="0"

# Secreto para invocar POST /api/cron/sync sin sesión (cron externo).
# Si no está definido, ese endpoint solo acepta sesión de admin.
CRON_SECRET=""

# --- Límite de frecuencia del formulario público de /participar --------------
# Solicitudes de inscripción permitidas por IP (hasheada) dentro de la ventana.
RATE_LIMIT_MAX_ATTEMPTS="5"
# Longitud de la ventana, en segundos (3600 = una hora).
RATE_LIMIT_WINDOW_SECONDS="3600"
# Una fila de contador sin actividad desde hace esto se purga. 86400 = un día.
RATE_LIMIT_STALE_SECONDS="86400"
# Secreto con el que se hashea la IP antes de guardarla (HMAC-SHA-256). Si no
# está definido se usa CRON_SECRET, y si tampoco, una sal fija en el código: la
# IP sigue sin guardarse en claro, pero con la sal fija un atacante con la tabla
# podría construir un diccionario de IPv4. Recomendado: una cadena larga y
# aleatoria, distinta de cualquier otra.
RATE_LIMIT_SALT=""

# --- Comprobación de perfil en la inscripción ---------------------------------
# Presupuesto total de la llamada a GET /players/:id al inscribirse, con la
# cancelación incluida. 8000 ms caben el intento inicial y algún reintento del
# cliente HTTP; si la API va muy lenta, sale el mensaje de reintentar.
REGISTRATION_PROFILE_TIMEOUT_MS="8000"

# --- Captcha (Cloudflare Turnstile) del formulario público ---------------------
# Site key PÚBLICA: la lee el componente cliente para montar el widget de
# /participar. Sin ella el componente no pinta el captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Secret key (SOLO servidor): con la que se verifica el token. Si NO está
# definida el captcha queda DESACTIVADO y el formulario funciona igual, sin
# comprobación: es lo que permite que el proyecto arranque sin configurar nada.
# En producción hay que definirla, o el endpoint público se queda sin captcha.
TURNSTILE_SECRET_KEY=""
# Presupuesto de la llamada a siteverify, en ms. 5000 ms alcanzan de sobra (es
# verificar un token ya emitido); si se pasa, sale el mensaje de reintentar.
TURNSTILE_TIMEOUT_MS="5000"

# Supabase (project settings → API). Auth is used only for the admin panel.
# Newer projects expose a publishable key instead of the legacy anon key.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
