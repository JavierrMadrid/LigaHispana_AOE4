    "verify:sync": "tsx --import ./scripts/prisma-wasm-node.mjs --conditions=react-server scripts/verify-sync.ts",
    "verify:alerts": "tsx --import ./scripts/prisma-wasm-node.mjs --conditions=react-server scripts/verify-alerts.ts",
